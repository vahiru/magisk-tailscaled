+func androidDNSServers(logf logger.Logf) []netip.Addr {
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	out, err := exec.CommandContext(ctx, "/system/bin/dumpsys", "connectivity").Output()
+	if err == nil {
+		if ns := parseDumpsysDNS(out); len(ns) > 0 {
+			return ns
+		}
+	} else {
+		logf("dns: dumpsys connectivity: %v", err)
+	}
+	var ns []netip.Addr
+	for _, p := range []string{"net.dns1", "net.dns2", "net.dns3", "net.dns4"} {
+		v, err := exec.CommandContext(ctx, "/system/bin/getprop", p).Output()
+		if err != nil {
+			continue
+		}
+		if ip, err := netip.ParseAddr(strings.TrimSpace(string(v))); err == nil && !ip.IsUnspecified() {
+			ns = append(ns, ip)
+		}
+	}
+	return ns
+}
