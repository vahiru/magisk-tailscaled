index 0000000..d6c3eed
--- /dev/null
+++ b/net/dns/dumpsys_dns.go
@@ -0,0 +1,65 @@
+// Copyright (c) Tailscale Inc & AUTHORS
+// SPDX-License-Identifier: BSD-3-Clause
+
+package dns
+
+import (
+	"bufio"
+	"bytes"
+	"net/netip"
+	"regexp"
+	"strings"
+)
+
+// Used by the Android OS configurator; kept free of build tags so it is unit tested.
+
+var (
+	reDefaultNetwork = regexp.MustCompile(`Active default network: (\d+)`)
+	reDNSAddresses   = regexp.MustCompile(`DnsAddresses: \[([^\]]*)\]`)
+)
+
+// androidDNSServers reads the DNS servers of the default (non-VPN) network from
+// `dumpsys connectivity`, falling back to the legacy net.dnsN properties.
+// parseDumpsysDNS extracts the DnsAddresses of the "Active default network" from
+// `dumpsys connectivity` output. Link-local servers are only used as a last resort.
+func parseDumpsysDNS(out []byte) []netip.Addr {
+	m := reDefaultNetwork.FindSubmatch(out)
+	if m == nil {
+		return nil
+	}
+	netTag := "network{" + string(m[1]) + "}"
+	sc := bufio.NewScanner(bytes.NewReader(out))
+	sc.Buffer(make([]byte, 0, 64*1024), 4*1024*1024)
+	for sc.Scan() {
+		line := sc.Text()
+		if !strings.Contains(line, netTag) {
+			continue
+		}
+		dm := reDNSAddresses.FindStringSubmatch(line)
+		if dm == nil {
+			continue
+		}
+		var global, linkLocal []netip.Addr
+		for _, f := range strings.Split(dm[1], ",") {
+			f = strings.TrimSpace(f)
+			f = strings.TrimPrefix(f, "/")
+			if i := strings.LastIndex(f, "/"); i >= 0 { // "hostname/1.2.3.4"
+				f = f[i+1:]
+			}
+			ip, err := netip.ParseAddr(f)
+			if err != nil || ip.IsUnspecified() {
+				continue
+			}
+			if ip.IsLinkLocalUnicast() {
+				linkLocal = append(linkLocal, ip)
+			} else {
+				global = append(global, ip.WithZone(""))
+			}
+		}
+		if len(global) > 0 {
+			return global
+		}
+		return linkLocal
+	}
+	return nil
+}
diff --git a/net/dns/dumpsys_dns_test.go b/net/dns/dumpsys_dns_test.go
new file mode 100644
index 0000000..04a8ed9
--- /dev/null
+++ b/net/dns/dumpsys_dns_test.go
@@ -0,0 +1,36 @@
+// Copyright (c) Tailscale Inc & AUTHORS
+// SPDX-License-Identifier: BSD-3-Clause
+
+package dns
+
+import (
+	"net/netip"
+	"reflect"
+	"testing"
+)
+
+func TestParseDumpsysDNS(t *testing.T) {
+	const dump = `NetworkProviders for:
+Active default network: 101
+Current Networks:
+  NetworkAgentInfo{network{100}  handle{429513165046}  ni{MOBILE CONNECTED extra: cmnet} lp{{InterfaceName: rmnet_data1 LinkAddresses: [ 10.1.2.3/30 ] DnsAddresses: [ /211.136.192.6,/120.196.165.24 ] Domains: null MTU: 1500}} nc{...}}
+  NetworkAgentInfo{network{101}  handle{433808132342}  ni{WIFI CONNECTED extra: } lp{{InterfaceName: wlan0 LinkAddresses: [ fe80::1/64,192.168.1.23/24 ] DnsAddresses: [ /fe80::1%wlan0,/192.168.1.1,/2408:8000::8 ] Domains: lan MTU: 0}} nc{...}}
+  NetworkAgentInfo{network{102}  ni{VPN CONNECTED extra: } lp{{InterfaceName: tun0 DnsAddresses: [ /198.18.0.2 ]}}}
+`
+	got := parseDumpsysDNS([]byte(dump))
+	want := []netip.Addr{netip.MustParseAddr("192.168.1.1"), netip.MustParseAddr("2408:8000::8")}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("got %v, want %v", got, want)
+	}
+
+	// Only link-local servers: use them.
+	ll := "Active default network: 7\n  NetworkAgentInfo{network{7} lp{{DnsAddresses: [ /fe80::1%wlan0 ]}}}\n"
+	if got := parseDumpsysDNS([]byte(ll)); len(got) != 1 || !got[0].IsLinkLocalUnicast() {
+		t.Fatalf("link-local fallback: got %v", got)
+	}
+
+	// No default network (airplane mode).
+	if got := parseDumpsysDNS([]byte("Active default network: none\n")); got != nil {
+		t.Fatalf("no default network: got %v", got)
+	}
+}
